export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions fast-syntax-highlighting rust docker docker-compose sudo extract dirhistory command-not-found)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

HISTFILE="$ZDOTDIR/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt autocd appendhistory sharehistory extended_history hist_ignore_dups hist_reduce_blanks

alias lg='lazygit'
alias vim='nvim'
alias cat='bat'
alias ls='eza'
alias dj='uv run python manage.py'
alias djrun='uv run python manage.py runserver_plus'
alias djshell='uv run python manage.py shell_plus'
alias djm='uv run python manage.py migrate'
alias djmm='uv run python manage.py makemigrations'
alias djt='uv run python manage.py test'
alias djc='uv run python manage.py check'
alias djst='uv run python manage.py startapp'

export EDITOR=nvim
export VISUAL=nvim

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
fi

# Automatically activate project .venv.
autoload -Uz add-zsh-hook

typeset -g AUTO_VENV=""

auto_venv() {
  local dir="$PWD"
  local venv=""

  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.venv/bin/activate" ]]; then
      venv="$dir/.venv"
      break
    fi
    dir="${dir:h}"
  done

  if [[ -n "$venv" && "$VIRTUAL_ENV" == "$venv" ]]; then
    return
  fi

  if [[ -n "$AUTO_VENV" && "$VIRTUAL_ENV" == "$AUTO_VENV" ]]; then
    deactivate 2>/dev/null
    AUTO_VENV=""
  fi

  if [[ -n "$venv" ]]; then
    source "$venv/bin/activate"
    AUTO_VENV="$venv"
  fi
}

add-zsh-hook chpwd auto_venv
auto_venv
eval "$(zellij setup --generate-auto-start zsh)"
