{
  "layer": "top",
  "position": "bottom", // i3bar zazwyczaj znajduje się na górze lub na dole
  "height": 24,      // i3bar jest z reguły dość niski i kompaktowy
  "spacing": 0,      // zero odstępów między elementami dla spójnego wyglądu bloków

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap"  // odpowiednik i3mode dla skrótów klawiszowych w Hyprland
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "battery",
    "clock"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "format": "{name}"
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%Y-%m-%d %H:%M:%S}",
    "interval": 1
  },

  "cpu": {
    "format": "CPU: {usage}%"
  },

  "memory": {
    "format": "RAM: {used:0.1f}G"
  },

  "pulseaudio": {
    "format": "VOL: {volume}%",
    "format-muted": "VOL: MUTED"
  },

  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}\n{ipaddr}",
    "on-click": "foot --app-id=wlctl -e wlctl",
  },

  "battery": {
    "format": "BAT: {capacity}%",
    "format-charging": "BAT: ⚡ {capacity}%"
  }
}
