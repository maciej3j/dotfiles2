"hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
        "*": 5
    }
},

"hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "separate-outputs": true
},

"network#signal": {
    "format-wifi": "WIFI {signalStrength}%",
    "format-ethernet": "ETH",
    "format-disconnected": "NET DOWN"
},

"custom/cpu": {
    "exec": "$HOME/.local/bin/waybar-cpu",
    "return-type": "json",
    "on-click": "foot -e htop"
},

"memory": {
    "interval": 2,
    "format": "RAM {percentage}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
},

"pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL MUTED"
},

"battery": {
    "format": "BAT {capacity}%",
    "format-charging": "BAT CHG {capacity}%",
    "format-plugged": "BAT AC {capacity}%"
},

"bluetooth": {
    "format": "BT",
    "format-disabled": "BT OFF",
    "format-connected": "BT {num_connections}"
},

"language": {
    "format": "LANG {}"
},

"clock": {
    "format": "%d.%m.%Y %H:%M"
}
